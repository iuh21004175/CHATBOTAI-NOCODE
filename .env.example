FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-me

DATABASE_URL=mysql+pymysql://root:@localhost:3306/aichatbot

REDIS_URL=redis://localhost:6379/0

CHROMA_HOST=localhost
CHROMA_PORT=8000

MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_BUCKET=aichatbot

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

DEEPSEEK_API_KEY=

EMBEDDING_MODEL_NAME=AITeamVN/Vietnamese_Embedding

# payOS (nạp AI Credit) — lấy từ trang quản trị payOS, CHỈ đặt trong .env thật, không commit
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Địa chỉ công khai của web (returnUrl/cancelUrl gửi payOS), vd https://abc.ngrok.app; trống = theo request hiện tại
PUBLIC_BASE_URL=

# Website Action Engine (Phase M) — mọi biến đều có mặc định an toàn, chỉ đặt khi cần đổi
# EMBEDDED_MODULE_WORKER=true            # run.py tự chạy worker phân tích module; false + `python -m workers.module_analysis` để tách riêng
# MODULE_MAX_URLS=6                      # số URL (file .zip) tối đa mỗi module
# MODULE_ZIP_MAX_BYTES=52428800          # cỡ file .zip tải lên tối đa (mặc định 50MB)
# MODULE_ZIP_MAX_FILES=500               # số file tối đa bên trong 1 .zip
# MODULE_ZIP_MAX_UNCOMPRESSED_BYTES=209715200  # chống zip bomb: tổng kích thước SAU khi giải nén tối đa (mặc định 200MB)
# MODULE_LLM_INPUT_CHARS=40000           # trần HTML rút gọn gửi DeepSeek mỗi URL
# AGENT_MAX_ACTION_CALLS=2               # số lần agent được gọi hành động trên website trong 1 lượt
# AGENT_ACTION_WAIT_SECONDS=8            # chờ widget báo kết quả mỗi lần gọi hành động

# Module "Đọc tài liệu" (khách gửi tệp trong widget) — xem docs/DOCUMENT_READER.md
# ATTACHMENT_MAX_BYTES=10485760          # cỡ tối đa 1 tệp (10 MB)
# ATTACHMENT_MAX_PER_MESSAGE=3           # số tệp tối đa mỗi tin
# ATTACHMENT_MAX_PER_CONVERSATION=6      # số tệp còn dùng được trong 1 hội thoại
# ATTACHMENT_MAX_TEXT_CHARS=300000       # trần văn bản trích ra từ 1 tệp
# ATTACHMENT_TOP_K=6                     # số đoạn tệp gần câu hỏi nhất đưa vào ngữ cảnh mỗi lượt
# ATTACHMENT_STALE_SECONDS=900           # quá hạn này mà tệp còn "processing" = tiến trình xử lý đã chết
# VISION_MAX_TOKENS=2000                 # trần token trả lời của 1 lệnh gọi DeepSeek vision (đọc ảnh/PDF bản scan — TỐN AI Credit)
# VISION_IMAGE_TOKENS=1024               # token quy đổi tối đa cho 1 ảnh (theo tài liệu DeepSeek vision)
# VISION_MAX_PDF_PAGES=20                # trần số trang đọc bằng vision cho 1 PDF dạng bản scan
# VISION_CONCURRENCY=2                   # số lệnh gọi vision đồng thời trong 1 tiến trình web

# App Builder (AB0) — xem docs/APP_BUILDER.md. Mỗi app = 1 database MySQL riêng.
# Tài khoản MySQL CÓ QUYỀN CREATE DATABASE/CREATE USER/GRANT (chỉ để cấp phát database cho app; tách khỏi DATABASE_URL). Production: đặt riêng, không dùng root.
# TENANT_DB_ADMIN_URL=mysql+pymysql://user:password@localhost:3306/
# TENANT_DB_USER_HOST=localhost
# TENANT_DB_QUOTA_MB=500
# BUILDER_MAX_APPS_PER_TEAM=5
# BUILDER_MAX_FIX_ROUNDS=2
